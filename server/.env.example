NODE_ENV=development
PORT=4000
APP_NAME=CodesExperts
APP_URL=https://codesexperts.com
APP_TIMEZONE=Asia/Kolkata

# MongoDB (e.g. a MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=codesexperts-react-db

# Only used by `npm run migrate:mongo` to copy the old MySQL data into MongoDB
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=codesexperts-react-db
MYSQL_USER=root
MYSQL_PASSWORD=

# Long random string used to sign admin login sessions
JWT_SECRET=change-me-to-a-long-random-string

# Folder with uploaded images (relative to server/)
UPLOADS_DIR=uploads
# Built React app served in production (relative to server/)
CLIENT_DIST=../client/dist

# SMTP for enquiry emails. Leave SMTP_HOST empty to log emails to the console instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=support@codesexperts.com
ADMIN_EMAIL=support@codesexperts.com
